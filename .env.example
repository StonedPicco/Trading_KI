# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# Without any keys the platform runs in DEMO mode with clearly labelled SIMULATED data.

# --- Environment -----------------------------------------------------------
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# Local quick-start uses SQLite; Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./ati_dev.db
# Optional shared secret for the API. Strongly recommended if not bound to localhost.
# API_TOKEN=
# CORS_ORIGINS=["http://localhost:3000"]

# --- Market data (Alpaca) ---------------------------------------------------
# auto = alpaca if keys are set, otherwise demo
DATA_PROVIDER=auto
# Free keys: create a (free) Alpaca paper account -> API keys. No funding required.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex = free real-time, single venue (partial volume). sip = consolidated (paid plan for real-time).
ALPACA_FEED=iex
# basic (free) | algo_trader_plus (paid, $99/month – only after explicit team approval)
ALPACA_PLAN=basic
INTRADAY_LOOKBACK_DAYS=60
SIMILARITY_LOOKBACK_DAYS=250
DAILY_LOOKBACK_DAYS=730

# --- SEC EDGAR (free) -------------------------------------------------------
# Required by SEC fair-access policy: descriptive name + contact e-mail.
# SEC_USER_AGENT=ATI Research yourname@example.com

# --- LLM (optional) ---------------------------------------------------------
# none | anthropic
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_NEWS_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_DAILY_BUDGET_USD=5
LLM_SERVER_SIDE_FALLBACK=true

# --- Monitoring -------------------------------------------------------------
# dev convenience; production requires a separate worker
RUN_WORKER_IN_API=true
MONITOR_INTERVAL_SECONDS=60
ANALYSIS_COOLDOWN_SECONDS=300
DEFAULT_WATCHLIST=["AAPL","NVDA","SPY"]
MIN_REWARD_RISK=1.5
SIMILARITY_MIN_SAMPLES=30
CALIBRATION_MIN_SAMPLES=50

# --- Docker Compose PostgreSQL ----------------------------------------------
POSTGRES_USER=ati
POSTGRES_PASSWORD=ati_dev_only
POSTGRES_DB=ati

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_TOKEN=       # only for local use; it is visible in the browser
